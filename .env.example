# Copia este archivo a .env y ajusta los valores. Nunca commitees .env real.

# Postgres local (docker-compose.dev.yml)
POSTGRES_USER=personalai
POSTGRES_PASSWORD=personalai
POSTGRES_DB=personalai
POSTGRES_PORT=5432

# Sesión Pro compartida de Claude Code (docs/hermes/spec.md §0.1/§0.3).
# Generar UNA VEZ en el host con `claude setup-token` (imprime el token por
# stdout, no lo persiste en ningún archivo). Compartido entre hermes-agent y
# claude-code-runner-mcp. NUNCA commitear el valor real — solo vive en .env.
# Riesgo de ToS aceptado conscientemente, ver docs/hermes/spec.md §0.2.
CLAUDE_CODE_OAUTH_TOKEN=

# --- apps/brain (Fase 4, docs/personal-brain/spec.md) -----------------------

# Apunta al Postgres de docker-compose.dev.yml para desarrollo local.
DATABASE_URL=postgres://personalai:personalai@localhost:5432/personalai

# Autenticación de la API HTTP de Brain (Bearer). Genéralo con:
#   openssl rand -hex 32
BRAIN_API_TOKEN=

# Proveedor de embeddings: Hugging Face Inference API (docs/personal-brain/spec.md §11).
# Token de solo lectura, generado en https://huggingface.co/settings/tokens.
HUGGINGFACE_API_KEY=
# Opcionales — por defecto BAAI/bge-m3, 1024 dimensiones (ver apps/brain/src/embeddings.ts).
# BRAIN_EMBEDDING_MODEL=BAAI/bge-m3
# BRAIN_EMBEDDING_DIMENSIONS=1024
# BRAIN_HTTP_PORT=8090
