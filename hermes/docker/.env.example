# Copia a .env en este mismo directorio y rellena los valores.
# NUNCA commitees el .env real (SEC-6.2 de docs/security.md).

# --- Rutas del host ---------------------------------------------------------

# Checkout de NousResearch/hermes-agent (lo instala su install.sh).
HERMES_AGENT_PATH=/home/TU_USUARIO/.hermes/hermes-agent

# Estado de hermes-agent (config, memorias, sesiones, cron). Se monta en
# /opt/data dentro del contenedor. Contiene material sensible (SEC-2.4).
HERMES_HOME=/home/TU_USUARIO/.hermes

# Raíz de los checkouts efímeros de cada tarea.
# IMPORTANTE: se monta en la MISMA ruta dentro del contenedor del runner. No es
# un capricho — los bind mounts de los contenedores efímeros los resuelve el
# demonio de Docker en el host, así que las rutas deben coincidir o el
# contenedor efímero recibe un /workspace vacío. Ver docs/hermes/spec.md §3.6.
WORKSPACE_ROOT=/var/lib/personalai/workspaces

# Fase 8 (US-8.2): directorio persistente para los HTML que genera
# run_claude_command (/design, /dataviz). Montado en la MISMA ruta en
# claude-code-runner (rw) y en hermes (ro) — el gateway de Telegram lee el
# fichero de aquí para entregarlo como adjunto real (tag MEDIA:). A
# diferencia de WORKSPACE_ROOT, nada lo limpia automáticamente todavía — ver
# apps/claude-code-runner-mcp/src/runClaudeCommand.ts::persistArtifact.
ARTIFACTS_ROOT=/var/lib/personalai/artifacts

# --- Secretos ---------------------------------------------------------------

# Autenticación del endpoint MCP del runner (SEC-3.2). Genéralo con:
#   openssl rand -hex 32
# Debe ser DISTINTO de cualquier otro secreto de este fichero (SEC-6.4).
CLAUDE_CODE_RUNNER_AUTH_TOKEN=

# Sesión Pro compartida entre hermes-agent y el runner (hermes-claude-auth).
# Se genera UNA vez en el host con `claude setup-token`, que lo imprime por
# stdout. Ver docs/hermes/spec.md §0.1/§0.3 — y §0.2 para el riesgo de ToS.
CLAUDE_CODE_OAUTH_TOKEN=

# PAT fine-grained de GitHub, scoped SOLO a los repos donde Hermes debe actuar,
# con permisos mínimos: contenidos, issues y pull requests (SEC-6.1).
# Nunca un token clásico de cuenta completa.
GITHUB_TOKEN=

# Postgres (esquema `runner` del runner, esquema `brain` de Brain — mismo
# Postgres, dos esquemas, ver docs/personal-brain/spec.md §6).
POSTGRES_USER=personalai
POSTGRES_PASSWORD=
POSTGRES_DB=personalai

# --- Brain (Fase 4/5, docs/personal-brain/spec.md) ---------------------------

# Autenticación de la API HTTP de Brain (SEC-6.4: secreto propio, distinto de
# los demás). Genéralo con: openssl rand -hex 32
BRAIN_API_TOKEN=

# Autenticación del endpoint MCP de brain-mcp (mismo patrón que
# CLAUDE_CODE_RUNNER_AUTH_TOKEN). Genéralo con: openssl rand -hex 32
BRAIN_MCP_AUTH_TOKEN=

# Proveedor de embeddings: Hugging Face Inference API (BAAI/bge-m3 por
# defecto). Token de solo lectura, https://huggingface.co/settings/tokens.
HUGGINGFACE_API_KEY=

# --- Gateway (Fase 3, Telegram) ---------------------------------------------

# Token del bot de Telegram, de @BotFather (SEC-1.3). Sin esto el adaptador de
# Telegram del gateway ni se activa. Secreto de primer nivel: quien lo tenga
# puede leer todo lo que se le escribe al bot y suplantarlo.
TELEGRAM_BOT_TOKEN=

# SEC-1.1: allowlist explícita de IDs de usuario de Telegram autorizados
# (numéricos, el tuyo lo da @userinfobot o similar), separados por comas.
# Sin esto (y sin pairing aprobado a mano) el gateway deniega por defecto,
# pero se fija explícitamente en vez de confiar en ese default.
# NUNCA pongas GATEWAY_ALLOW_ALL_USERS ni TELEGRAM_ALLOW_ALL_USERS a true
# (SEC-1.2): cualquiera que encuentre el bot podría mandarle tareas de código.
TELEGRAM_ALLOWED_USERS=

# --- Límites (SEC-4.3) ------------------------------------------------------

# La ventana de cuota de la suscripción Pro es COMPARTIDA entre el chat de
# hermes y las tareas de código: un pico de tareas puede dejar mudo al chat.
CLAUDE_CODE_RUNNER_MAX_CONCURRENT=2
CLAUDE_CODE_RUNNER_MAX_PER_HOUR=10
