# Configuración de metrics-webhook.sh. Cópiese junto al script en
# $HERMES_HOME/scripts/metrics-webhook.env y protéjase con `chmod 600`:
# contiene el mismo secreto que autentica el endpoint MCP del runner.
#
# El script se ejecuta con el entorno saneado por hermes-agent, así que estas
# variables NO pueden venir del .env del compose — tienen que estar aquí.

# Nombre del servicio en la red interna de Compose + puerto HTTP del runner.
# No es una URL pública: el servicio no publica `ports:` (SEC-3.1).
RUNNER_URL=http://claude-code-runner:8080

# El MISMO valor que CLAUDE_CODE_RUNNER_AUTH_TOKEN en hermes/docker/.env.
RUNNER_TOKEN=
